# ============================================================
# Comic RAG Frontend Environment Configuration
# ============================================================

# Backend API Base URL
# Local development default: http://127.0.0.1:8000
# Production deployment: change to your production server address:
# Examples:
VITE_API_BASE_URL=http://13.218.185.215:8000
#   VITE_API_BASE_URL=https://api.yourcomicdomain.com
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Frontend Development Server Port
# Default: 5173
VITE_PORT=5173

# Timeout for standard API requests (chat, metadata, etc.) in milliseconds
# Default: 60000 (60 seconds)
VITE_API_TIMEOUT=60000

# Timeout for comic upload & background processing in milliseconds
# Default: 300000 (5 minutes)
VITE_UPLOAD_TIMEOUT=300000

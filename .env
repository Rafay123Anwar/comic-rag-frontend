# ============================================================
# Comic RAG Frontend Environment Configuration
# ============================================================

# Backend API Base URL
# To deploy to production, simply change this line to your production server URL:
# e.g.: VITE_API_BASE_URL=http://13.218.185.215:8000
VITE_API_BASE_URL=http://13.218.185.215:8000

# Frontend Development Server Port
VITE_PORT=5173

# Timeout for standard API requests (60 seconds)
VITE_API_TIMEOUT=60000

# Timeout for comic upload & ingestion (5 minutes)
VITE_UPLOAD_TIMEOUT=300000
